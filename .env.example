# ============================================================================
# Environment variable reference for the whole project.
# The backend reads backend/.env and the frontend reads frontend/.env.
# Copy the matching section below into each file (or copy backend/.env.example
# and frontend/.env.example directly). Never commit real .env files.
# ============================================================================

# ---------------- backend/.env ----------------
# Copy to .env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=5000

# MongoDB connection string (local MongoDB, Docker, or Atlas).
MONGODB_URI=mongodb://127.0.0.1:27017/campus_complaints

# Signs session tokens. Use a long random value, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
# Session lifetime (jsonwebtoken format: 30m, 8h, 7d).
JWT_TTL=8h
# Set true when served over HTTPS (always in production).
COOKIE_SECURE=false

# Comma-separated list of allowed frontend origins (exact match).
CORS_ORIGINS=http://localhost:5173

# Where complaint images are stored (outside any public folder) and max size in bytes.
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# Repeated-issue rule: MORE THAN this many distinct reporters of the same category+location -> Critical.
ESCALATION_THRESHOLD=5
# Days within which reports of a not-yet-escalated issue are counted together. 0 = no window.
ESCALATION_WINDOW_DAYS=30

# AI agents: Google Gemini (Developer API). Leave GEMINI_API_KEY empty for demo mode, where every
# agent uses clearly labelled rule-based fallbacks. Get a key at https://aistudio.google.com/apikey
# Keep the key here (backend/.env, git-ignored) or in your environment only. It is never sent to the
# browser, returned by the API, or written to logs.
GEMINI_API_KEY=
# Stable Flash-Lite model, listed as "Free of charge" on the free tier on Google's pricing page
# (checked 2026-10-11). Free-tier rate limits are per project and shown in AI Studio, not in the docs.
GEMINI_MODEL=gemini-3.5-flash-lite
# Only for a proxy, gateway or local test server. Leave empty for Google's endpoint.
GEMINI_BASE_URL=
# Optional thinking level for the Interactions API (for example "low"). Empty = the model's default.
GEMINI_THINKING_LEVEL=
# Ask Gemini for schema-constrained JSON (answers are validated with zod either way).
# If live calls fail with HTTP 400 invalid_request, set this to false.
GEMINI_STRUCTURED_OUTPUT=true
# App-side cap on Gemini requests per minute, to protect the free-tier quota (0 = no cap).
# Each new complaint uses up to 3 requests. Set this to your project's limit shown in AI Studio.
GEMINI_MAX_REQUESTS_PER_MINUTE=10
# After a daily-quota error (429 quota_exceeded), skip Gemini for this many minutes.
# Per-minute 429s pause for the Retry-After time, or 30 seconds.
GEMINI_QUOTA_COOLDOWN_MINUTES=60
AI_TIMEOUT_MS=30000
# Output budget per call. Gemini counts thinking tokens as output, so keep headroom above the JSON answers.
AI_MAX_TOKENS=4000
# Automatically assign new complaints to eligible staff.
AUTO_ASSIGN_ENABLED=true

# Max sign-in attempts per IP+email per 15 minutes.
LOGIN_RATE_LIMIT_MAX=10

# Optional seed passwords (otherwise random ones are generated and printed once by `npm run seed`).
SEED_ADMIN_EMAIL=admin@campus.example
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=

# ---------------- frontend/.env (optional) ----------------
# Frontend build-time settings (Vite). Copy to frontend/.env if you need to change them.
# Nothing secret belongs here: every VITE_* value is embedded in the public JavaScript bundle.

# Leave empty when the API is served from the same site under /api (recommended; required for the
# SameSite=Strict session cookie). Only set it if the API is on another origin of the SAME site.
VITE_API_BASE_URL=

# Development only: where `npm run dev` / `npm run preview` proxy /api requests.
VITE_DEV_API_TARGET=http://localhost:5000
