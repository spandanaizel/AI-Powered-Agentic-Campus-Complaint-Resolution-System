# Copy to .env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=5000

# MongoDB connection string (local MongoDB, Docker, or Atlas).
MONGODB_URI=mongodb://127.0.0.1:27017/campus_complaints

# Signs session tokens. Use a long random value, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
# Session lifetime (jsonwebtoken format: 30m, 8h, 7d).
JWT_TTL=8h
# Set true when served over HTTPS (always in production).
COOKIE_SECURE=false

# Comma-separated list of allowed frontend origins (exact match).
CORS_ORIGINS=http://localhost:5173

# Where complaint images are stored (outside any public folder) and max size in bytes.
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# Repeated-issue rule: MORE THAN this many distinct reporters of the same category+location -> Critical.
ESCALATION_THRESHOLD=5
# Days within which reports of a not-yet-escalated issue are counted together. 0 = no window.
ESCALATION_WINDOW_DAYS=30

# AI agents. Leave ANTHROPIC_API_KEY empty to run with clearly labelled non-AI fallbacks.
# Supply the key through the environment or this file only; never commit it.
ANTHROPIC_API_KEY=
# Current Claude API model ID (checked against Anthropic's models page, Oct 2026).
ANTHROPIC_MODEL=claude-haiku-5-5
# Only change for a proxy or gateway.
ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_TIMEOUT_MS=30000
# Output budget per call. Current models think adaptively and thinking counts against this budget.
AI_MAX_TOKENS=4000
# Automatically assign new complaints to eligible staff.
AUTO_ASSIGN_ENABLED=true

# Max sign-in attempts per IP+email per 15 minutes.
LOGIN_RATE_LIMIT_MAX=10

# Optional seed passwords (otherwise random ones are generated and printed once by `npm run seed`).
SEED_ADMIN_EMAIL=admin@campus.example
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
