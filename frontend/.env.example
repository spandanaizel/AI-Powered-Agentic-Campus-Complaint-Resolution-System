# Frontend build-time settings (Vite). Copy to frontend/.env if you need to change them.
# Nothing secret belongs here: every VITE_* value is embedded in the public JavaScript bundle.

# Leave empty when the API is served from the same site under /api (recommended; required for the
# SameSite=Strict session cookie). Only set it if the API is on another origin of the SAME site.
VITE_API_BASE_URL=

# Development only: where `npm run dev` / `npm run preview` proxy /api requests.
VITE_DEV_API_TARGET=http://localhost:5000
